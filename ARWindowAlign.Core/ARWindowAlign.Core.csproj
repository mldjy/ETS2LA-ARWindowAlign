<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <OutputType>library</OutputType>
    <AssemblyName>ARWindowAlign.Core</AssemblyName>
    <RootNamespace>ARWindowAlign.Core</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- ETS2LA 安装目录（编译期引用其程序集，运行时不随附） -->
    <Ets2laDir Condition="'$(Ets2laDir)' == ''">$(LOCALAPPDATA)\ETS2LA\current</Ets2laDir>
  </PropertyGroup>

  <!-- 这个程序集由插件显式加载到默认(不可回收)的 AssemblyLoadContext。
       补丁方法必须住在这里，否则 Harmony 无法从不可回收上下文引用可回收上下文的方法。 -->
  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(MSBuildProjectDirectory)\..\lib\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Hexa.NET.ImGui">
      <HintPath>$(Ets2laDir)\Hexa.NET.ImGui.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Hexa.NET.OpenGL.Core">
      <HintPath>$(Ets2laDir)\Hexa.NET.OpenGL.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Hexa.NET.OpenGL3">
      <HintPath>$(Ets2laDir)\Hexa.NET.OpenGL3.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
